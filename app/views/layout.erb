<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>MyWay</title>
    <style>
      :root { color-scheme: light dark; }
      body {
        font-family: system-ui, sans-serif;
        max-width: 30rem;
        margin: 4rem auto;
        padding: 0 1rem;
      }
      h1 { margin-bottom: 0.25rem; }
      p.tagline { margin-top: 0; opacity: 0.7; }
      form { display: flex; flex-direction: column; gap: 0.5rem; margin-top: 1.5rem; }
      input, button { padding: 0.6rem; font-size: 1rem; }
      button { cursor: pointer; }
      .notice { margin-top: 1.5rem; padding: 0.75rem; border-radius: 0.5rem; border: 1px solid currentColor; }
      .notice.success { color: #157f3d; }
      .notice.error { color: #b3261e; }
      .notice a { color: inherit; }
    </style>
  </head>
  <body>
    <h1>MyWay</h1>
    <p class="tagline">A tiny URL shortener.</p>
    <%= yield %>
  </body>
</html>