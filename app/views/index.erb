<form action="/shorten" method="post">
  <input name="url" type="url" placeholder="https://..." required>
  <input name="code" placeholder="custom code (optional)">
  <button>Shorten</button>
</form>

<% if link_url %>
  <p class="notice success" role="status">Short link: <a href="<%= h(link_url) %>"><%= h(link_url) %></a></p>
<% elsif message %>
  <p class="notice error" role="alert"><%= h(message) %></p>
<% end %>